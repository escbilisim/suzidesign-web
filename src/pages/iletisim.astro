---
import Layout from '../layouts/Layout.astro';

const contactPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'İletişim · Suzi Design',
  url: 'https://suzidesign.com/iletisim',
  inLanguage: 'tr-TR',
};
---

<Layout
  title="İletişim"
  description="Suzi Design ile iletişime geçin. Kişiye özel dikim, toptan sipariş ve genel sorularınız için 24 saat içinde dönüş yapıyoruz."
  lang="tr"
  schema={contactPageSchema}
>
  <section class="section contact-hero">
    <div class="container--narrow text-center">
      <span class="eyebrow">İletişim</span>
      <h1>Görüşmeye başlayalım.</h1>
      <p class="lead">
        Kişiye özel dikim ya da toptan sipariş; aklınızdaki her soru için 24 saat içinde
        size dönüş yapıyoruz.
      </p>
    </div>
  </section>

  <section class="section contact-grid-section">
    <div class="container contact-grid">
      <form class="contact-form" action="/api/contact" method="POST" novalidate id="contact-form">
        <h2 style="font-style:italic">Form</h2>

        <!-- Status mesajları (JS aktif olduğunda doldurulur) -->
        <div class="contact-form__status" role="status" aria-live="polite" hidden></div>

        <!-- Honeypot (bot tuzağı, kullanıcı görmez) -->
        <div class="hp" aria-hidden="true">
          <label>
            Web sitenizi yazmayın (bot tuzağı):
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <label>
          <span>Adınız *</span>
          <input type="text" name="name" required autocomplete="name" />
        </label>

        <label>
          <span>E-posta *</span>
          <input type="email" name="email" required autocomplete="email" />
        </label>

        <label>
          <span>Telefon (opsiyonel)</span>
          <input type="tel" name="phone" autocomplete="tel" />
        </label>

        <label>
          <span>Konu *</span>
          <select name="topic" required>
            <option value="">Seçin...</option>
            <option value="bireysel">Bireysel: kişiye özel dikim</option>
            <option value="toptan">Toptan / butik siparişi</option>
            <option value="diger">Diğer</option>
          </select>
        </label>

        <label>
          <span>Mesajınız *</span>
          <textarea name="message" rows="6" required placeholder="Düşündüğünüz model, kumaş, ölçü, tarih vb. ne kadar detaylı yazarsanız, dönüşümüz de o kadar isabetli olur."></textarea>
        </label>

        <button type="submit" class="btn btn--primary" id="contact-submit">
          <span class="contact-submit__label">Mesajı gönder</span>
        </button>

        <p class="form-note">
          * işaretli alanlar zorunludur. Gönderdiğiniz bilgiler yalnızca size dönüş yapabilmek için kullanılır.
          Bkz. <a href="/gizlilik">Gizlilik</a>.
        </p>
      </form>

      <aside class="contact-side">
        <h3 style="font-style:italic">Diğer yollar</h3>

        <div class="contact-side__item">
          <h4>Instagram</h4>
          <p>
            <a href="https://instagram.com/suzidesignn" target="_blank" rel="noopener noreferrer">@suzidesignn</a>
          </p>
          <p class="contact-side__hint">Koleksiyon ve günlük güncellemeler.</p>
        </div>

        <div class="contact-side__item">
          <h4>Yanıt süresi</h4>
          <p>Ortalama 24 saat içinde.</p>
          <p class="contact-side__hint">Hafta sonu ve resmi tatillerde gecikebilir.</p>
        </div>

        <div class="contact-side__item">
          <h4>Atölye</h4>
          <p>İstanbul, Türkiye</p>
          <p class="contact-side__hint">Görüşme randevuyla; lütfen önce form üzerinden ulaşın.</p>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .text-center { text-align: center; }
  .contact-hero { padding-top: var(--s-7); padding-bottom: var(--s-5); }
  .contact-hero h1 { font-style: italic; }

  .contact-grid-section { padding-top: var(--s-3); padding-bottom: var(--s-8); }
  .contact-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--s-7);
    align-items: start;
  }

  /* Form */
  .contact-form {
    background: var(--c-cream);
    padding: var(--s-6);
    border-radius: var(--r-card);
  }
  .contact-form h2 { margin: 0 0 var(--s-5); }
  .contact-form label {
    display: block;
    margin-bottom: var(--s-4);
  }
  .contact-form label span {
    display: block;
    margin-bottom: var(--s-2);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-primary);
  }
  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    width: 100%;
    padding: 0.875rem 1rem;
    font: inherit;
    font-size: 1rem;
    border: 1px solid var(--c-border);
    background: var(--c-white);
    border-radius: var(--r-input);
    color: var(--c-primary);
    transition: border-color var(--t-fast), box-shadow var(--t-fast);
  }
  .contact-form input:focus,
  .contact-form select:focus,
  .contact-form textarea:focus {
    border-color: var(--c-accent-dark);
    box-shadow: 0 0 0 3px rgba(201, 168, 124, 0.20);
    outline: none;
  }
  .contact-form textarea { resize: vertical; min-height: 140px; }

  /* Honeypot: visually hidden */
  .hp {
    position: absolute !important;
    left: -10000px !important;
    width: 1px; height: 1px; overflow: hidden;
  }

  .form-note {
    margin-top: var(--s-4);
    font-size: 0.8125rem;
    color: var(--c-text-muted);
    line-height: 1.5;
  }

  /* Status box */
  .contact-form__status {
    padding: var(--s-3) var(--s-4);
    margin-bottom: var(--s-4);
    border-radius: var(--r-input);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .contact-form__status[data-state="success"] {
    background: rgba(34, 139, 34, 0.08);
    border: 1px solid rgba(34, 139, 34, 0.30);
    color: #1e6b1e;
  }
  .contact-form__status[data-state="error"] {
    background: rgba(180, 40, 40, 0.06);
    border: 1px solid rgba(180, 40, 40, 0.30);
    color: #8b2626;
  }
  .contact-form__status[data-state="loading"] {
    background: rgba(201, 168, 124, 0.10);
    border: 1px solid rgba(201, 168, 124, 0.40);
    color: var(--c-accent-dark);
  }

  /* Button loading state */
  .contact-form button[disabled] {
    opacity: 0.65;
    cursor: not-allowed;
  }
  .contact-submit__label::after {
    content: '';
    display: inline-block;
    width: 14px; height: 14px;
    margin-left: var(--s-2);
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    vertical-align: -2px;
    opacity: 0;
    animation: contact-spin 0.7s linear infinite;
    transition: opacity 150ms ease;
  }
  button[data-loading="true"] .contact-submit__label::after { opacity: 1; }
  @keyframes contact-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    .contact-submit__label::after { animation: none; }
  }

  /* Side */
  .contact-side h3 { margin-bottom: var(--s-4); }
  .contact-side__item { margin-bottom: var(--s-5); }
  .contact-side__item h4 {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-accent-dark);
    margin-bottom: var(--s-2);
  }
  .contact-side__item p { margin: 0 0 var(--s-1); }
  .contact-side__hint {
    font-size: 0.875rem;
    color: var(--c-text-muted);
  }

  @media (max-width: 768px) {
    .contact-grid { grid-template-columns: 1fr; gap: var(--s-5); }
    .contact-form { padding: var(--s-4); }
  }
</style>

<script>
  // Progressive enhancement: JS yoksa form normal POST + sunucu cevap sayfası.
  // JS varsa fetch ile gönder, inline success/error mesajı göster.
  const form   = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.querySelector<HTMLDivElement>('.contact-form__status');
  const button = document.getElementById('contact-submit') as HTMLButtonElement | null;

  if (form && status && button) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Reset
      status.hidden = false;
      status.dataset.state = 'loading';
      status.textContent = 'Mesajınız gönderiliyor...';
      button.disabled = true;
      button.setAttribute('data-loading', 'true');

      try {
        const formData = new FormData(form);
        const res = await fetch('/api/contact', {
          method: 'POST',
          body: formData,
          headers: { 'Accept': 'application/json' },
        });

        const data: { ok: boolean; error?: string } = await res.json().catch(() => ({ ok: false, error: 'Sunucu cevabı okunamadı.' }));

        if (data.ok) {
          status.dataset.state = 'success';
          status.textContent = 'Teşekkürler, mesajınız ulaştı. 24 saat içinde dönüş yapacağız.';
          form.reset();
          // Form üst noktasına scroll
          status.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          status.dataset.state = 'error';
          status.textContent = data.error ?? 'Bir sorun oluştu. Lütfen tekrar deneyin.';
        }
      } catch (err) {
        status.dataset.state = 'error';
        status.textContent = 'Bağlantı hatası. Lütfen birazdan tekrar deneyin.';
      } finally {
        button.disabled = false;
        button.removeAttribute('data-loading');
      }
    });
  }
</script>
