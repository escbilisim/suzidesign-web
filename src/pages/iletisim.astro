---
import Layout from '../layouts/Layout.astro';

const contactPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'İletişim · Suzi Design',
  url: 'https://suzidesign.com/iletisim',
  inLanguage: 'tr-TR',
};
---

<Layout
  title="İletişim"
  description="Suzi Design ile iletişime geçin. Kişiye özel dikim, toptan sipariş ve genel sorularınız için 24 saat içinde dönüş yapıyoruz."
  lang="tr"
  schema={contactPageSchema}
>
  <section class="section contact-hero">
    <div class="container--narrow text-center">
      <span class="eyebrow">İletişim</span>
      <h1>Görüşmeye başlayalım.</h1>
      <p class="lead">
        Kişiye özel dikim ya da toptan sipariş; aklınızdaki her soru için 24 saat içinde
        size dönüş yapıyoruz.
      </p>
    </div>
  </section>

  <section class="section contact-grid-section">
    <div class="container contact-grid">
      <form class="contact-form" action="/api/contact" method="POST" novalidate>
        <h2 style="font-style:italic">Form</h2>

        <!-- Honeypot (bot tuzağı, kullanıcı görmez) -->
        <div class="hp" aria-hidden="true">
          <label>
            Web sitenizi yazmayın (bot tuzağı):
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <label>
          <span>Adınız *</span>
          <input type="text" name="name" required autocomplete="name" />
        </label>

        <label>
          <span>E-posta *</span>
          <input type="email" name="email" required autocomplete="email" />
        </label>

        <label>
          <span>Telefon (opsiyonel)</span>
          <input type="tel" name="phone" autocomplete="tel" />
        </label>

        <label>
          <span>Konu *</span>
          <select name="topic" required>
            <option value="">Seçin...</option>
            <option value="bireysel">Bireysel: kişiye özel dikim</option>
            <option value="toptan">Toptan / butik siparişi</option>
            <option value="diger">Diğer</option>
          </select>
        </label>

        <label>
          <span>Mesajınız *</span>
          <textarea name="message" rows="6" required placeholder="Düşündüğünüz model, kumaş, ölçü, tarih vb. ne kadar detaylı yazarsanız, dönüşümüz de o kadar isabetli olur."></textarea>
        </label>

        <button type="submit" class="btn btn--primary">Mesajı gönder</button>

        <p class="form-note">
          * işaretli alanlar zorunludur. Gönderdiğiniz bilgiler yalnızca size dönüş yapabilmek için kullanılır.
          Bkz. <a href="/gizlilik">Gizlilik</a>.
        </p>

        <p class="form-note form-note--phase4">
          (Form gönderimi Phase 4'te aktive olacak. Şu an iskelet halinde.)
        </p>
      </form>

      <aside class="contact-side">
        <h3 style="font-style:italic">Diğer yollar</h3>

        <div class="contact-side__item">
          <h4>Instagram</h4>
          <p>
            <a href="https://instagram.com/suzidesignn" target="_blank" rel="noopener noreferrer">@suzidesignn</a>
          </p>
          <p class="contact-side__hint">Koleksiyon ve günlük güncellemeler.</p>
        </div>

        <div class="contact-side__item">
          <h4>Yanıt süresi</h4>
          <p>Ortalama 24 saat içinde.</p>
          <p class="contact-side__hint">Hafta sonu ve resmi tatillerde gecikebilir.</p>
        </div>

        <div class="contact-side__item">
          <h4>Atölye</h4>
          <p>İstanbul, Türkiye</p>
          <p class="contact-side__hint">Görüşme randevuyla; lütfen önce form üzerinden ulaşın.</p>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .text-center { text-align: center; }
  .contact-hero { padding-top: var(--s-7); padding-bottom: var(--s-5); }
  .contact-hero h1 { font-style: italic; }

  .contact-grid-section { padding-top: var(--s-3); padding-bottom: var(--s-8); }
  .contact-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--s-7);
    align-items: start;
  }

  /* Form */
  .contact-form {
    background: var(--c-cream);
    padding: var(--s-6);
    border-radius: var(--r-card);
  }
  .contact-form h2 { margin: 0 0 var(--s-5); }
  .contact-form label {
    display: block;
    margin-bottom: var(--s-4);
  }
  .contact-form label span {
    display: block;
    margin-bottom: var(--s-2);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-primary);
  }
  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    width: 100%;
    padding: 0.875rem 1rem;
    font: inherit;
    font-size: 1rem;
    border: 1px solid var(--c-border);
    background: var(--c-white);
    border-radius: var(--r-input);
    color: var(--c-primary);
    transition: border-color var(--t-fast), box-shadow var(--t-fast);
  }
  .contact-form input:focus,
  .contact-form select:focus,
  .contact-form textarea:focus {
    border-color: var(--c-accent-dark);
    box-shadow: 0 0 0 3px rgba(201, 168, 124, 0.20);
    outline: none;
  }
  .contact-form textarea { resize: vertical; min-height: 140px; }

  /* Honeypot: visually hidden */
  .hp {
    position: absolute !important;
    left: -10000px !important;
    width: 1px; height: 1px; overflow: hidden;
  }

  .form-note {
    margin-top: var(--s-4);
    font-size: 0.8125rem;
    color: var(--c-text-muted);
    line-height: 1.5;
  }
  .form-note--phase4 {
    margin-top: var(--s-2);
    color: var(--c-accent-dark);
    font-style: italic;
  }

  /* Side */
  .contact-side h3 { margin-bottom: var(--s-4); }
  .contact-side__item { margin-bottom: var(--s-5); }
  .contact-side__item h4 {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-accent-dark);
    margin-bottom: var(--s-2);
  }
  .contact-side__item p { margin: 0 0 var(--s-1); }
  .contact-side__hint {
    font-size: 0.875rem;
    color: var(--c-text-muted);
  }

  @media (max-width: 768px) {
    .contact-grid { grid-template-columns: 1fr; gap: var(--s-5); }
    .contact-form { padding: var(--s-4); }
  }
</style>
